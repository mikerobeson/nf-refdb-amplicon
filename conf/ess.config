/*
========================================================================================
    ESS CONFIG
========================================================================================
    Configuration for the Extract Sequence Segments (ESS) pipeline.
----------------------------------------------------------------------------------------
*/

/*
----------------------------------------------------------------------------------------
    PARAMETERS
----------------------------------------------------------------------------------------
*/

params {

    ess {
        // Data source
        // Options: 'custom', 'ncbi', 'unite', 'midori2', 'pr2', 'silva', 'gtdb', 'rdp'
        source              = 'custom'

        // Input files (required when source is 'custom')
        seqs                = null
        taxa                = null
        seqsegs             = null

        // Database and region identifiers
        db                  = 'refdb'
        amp_seg             = 'segment'

        // Iteration settings
        train_classifier    = true

        // Iteration schedule: pairs of (perc_identity, n_iterations), run in order.
        // Each stage's output seeds the next. e.g. [[0.7, 2], [0.8, 2], [0.9, 1]]
        // = 2 iterations @ 0.7, then 2 @ 0.8, then 1 @ 0.9 (5 total).
        // From the command line: --ess.iteration_schedule "[(0.7, 2), (0.8, 2), (0.9, 1)]"
        iteration_schedule  = [[0.7, 2]]

        // Extract seq segments parameters
        min_seq_len         = '10'
        max_seq_len         = '50000'

        // Primer sequences for initial segment extraction
        // Required when source is not 'custom' and seqsegs is not provided
        fwd_primer          = null
        rev_primer          = null
        extract_min_length  = 10
        extract_max_length  = 0

        // MIDORI2-specific (when source is 'midori2')
        midori2_version     = ''
        midori2_target_gene = 'COI'

        
        
    }

    // NCBI-specific (when source is 'ncbi')
    ncbi {
        query          = ''
        ranks          = 'kingdom phylum class order family genus species'
        rank_propagation = true   
    }

    // UNITE-specific (when source is 'unite')
    unite {
        version       = '2025-02-19'
        taxon_group   = 'eukaryotes'
        cluster_id    = '99'
        singletons    = false
    }

    // PR2-specific (when source is 'pr2')
    pr2 {
        version         = '5.1.1'
        ranks           = 'domain supergroup division subdivision class order family genus species'
    }
}


/*
----------------------------------------------------------------------------------------
    PROCESS CONFIGURATION
----------------------------------------------------------------------------------------
*/

process {

    withLabel: 'process_long' {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: 'ess_setup' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withLabel: 'ess_extseqsegs' {
        cpus   = { params.max_cpus as int }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'ess_iterate' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'train_classifier' {
        cpus   = 1
        memory = { 14.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: '.*ESS.*' {
        publishDir = [
            path: "${params.outdir}/ess",
            mode: params.publish_dir_mode,
        ]
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/